@@ -46,9 +46,12 @@ TricoreTargetELFStreamer::TricoreTargetELFStreamer(MCStreamer &S,
                                                const MCSubtargetInfo &STI)
     : TricoreTargetStreamer(S) {
   ELFObjectWriter &W = getStreamer().getWriter();
-  unsigned EFlags = W.getELFHeaderEFlags();

-  W.setELFHeaderEFlags(EFlags);
+  // GNU/HighTec TriCore objects use bit 19 in e_flags.  Emit the same flag
+  // so LLVM-generated objects can be linked with the GNU TriCore toolchain.
+  // Preserve any flags that may already have been installed by the streamer.
+  constexpr unsigned TricoreGNUELFFlag = 0x00080000U;
+  W.setELFHeaderEFlags(W.getELFHeaderEFlags() | TricoreGNUELFFlag);
 }

